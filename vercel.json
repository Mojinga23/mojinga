{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build || echo 'Using prebuilt dist'",
  "outputDirectory": "frontend/dist/frontend/browser",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://api.threeapp.site/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
